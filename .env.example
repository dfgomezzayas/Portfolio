# EmailJS — used server-side by app/actions/sendEmail.ts
# Public/Service/Template IDs come from your EmailJS dashboard.
# EMAILJS_PRIVATE_KEY is the "Private Key" (allows server-side sends
# without the browser Origin check) — keep it secret, server-only.
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_KEY=
EMAILJS_TEMPLATE_KEY=

# Upstash Redis — used by lib/rate-limit.ts to rate-limit the contact form.
# Free tier: https://upstash.com — create a Redis database and copy the
# REST URL/token from its dashboard. Without these set, rate limiting is
# disabled (fails open) and a warning is logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
